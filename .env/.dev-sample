FASTAPI_CONFIG=development

# Celery
CELERY_BROKER_URL=redis://dragonfly:6379/0
CELERY_RESULT_BACKEND=redis://dragonfly:6379/0

# OceanBase
OB_HOST=oceanbase
OB_PORT=2881
OB_USER=root@sys
OB_PASSWORD=
OB_DATABASE=oceanbase
OB_CHARSET=utf8mb4

# Dragonfly
DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=6379

# Milvus
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_MAX_RETRIES=5
MILVUS_RETRY_DELAY=3

# EMQX / MQTT
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=python_test_script
MQTT_TOPIC=iot/test/conexion
MQTT_KEEPALIVE=60
MQTT_MAX_RETRIES=5
MQTT_RETRY_DELAY=3
MQTT_STARTUP_DELAY=1
MQTT_MESSAGE_DELAY=2
